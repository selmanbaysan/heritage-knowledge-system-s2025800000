# Q1: Find all claims with confidence > 0.8 (RDF-Star version)
# Returns the claim details along with their confidence scores

PREFIX ex: <http://example.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?subject ?predicate ?object ?confidence
WHERE {
    # RDF-Star allows direct annotation of triples using << >> syntax
    << ?subject ?predicate ?object >> ex:confidence ?confidence .
    
    FILTER (?confidence > 0.8)
}