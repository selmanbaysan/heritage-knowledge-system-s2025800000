# Q1: Find all claims with confidence > 0.8 (Named Graphs version)
# Returns the claim details along with their confidence scores

PREFIX ex: <http://example.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?subject ?predicate ?object ?confidence
WHERE {
    GRAPH ?claimGraph {
        ?subject ?predicate ?object .
    }
    
    GRAPH ?metadataGraph {
        ?claimGraph ex:confidence ?confidence .
    }
    
    FILTER (?confidence > 0.8)
}