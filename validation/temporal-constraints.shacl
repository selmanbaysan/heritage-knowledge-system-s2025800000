@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <http://example.org/> .
@prefix heritage: <http://www.semanticweb.org/selmanbaysan/ontologies/2025/11/heritage-ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .


ex:SpiritualGuardianApprovalShape
    a sh:NodeShape ;
    sh:targetClass heritage:SpiritualGuardian ;
    sh:property [
        sh:path heritage:humanApproval ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Spiritual Guardian requires human approval (humanApproval must be true)." ;
    ] .


ex:ElderApprovalShape
    a sh:NodeShape ;
    sh:targetSubjectsOf heritage:humanApproval ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Individuals with humanApproval=true must be approved by a TribalElder." ;
        sh:severity sh:Violation ;
        sh:select """
            PREFIX heritage: <http://www.semanticweb.org/selmanbaysan/ontologies/2025/11/heritage-ontology#>
            SELECT $this
            WHERE {
                $this heritage:humanApproval true .
                FILTER NOT EXISTS {
                    $this heritage:approvedBy ?elder .
                    ?elder a heritage:TribalElder .
                }
            }
        """
    ] .

ex:TemporalAccessShape
    a sh:NodeShape ;
    sh:targetClass heritage:Recording ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Recording made after restriction without proper authorization (Performer Level too low)." ;
        sh:severity sh:Violation ;
        sh:select """
            PREFIX heritage: <http://www.semanticweb.org/selmanbaysan/ontologies/2025/11/heritage-ontology#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            
            SELECT $this
            WHERE {
                $this heritage:recordingDate ?recDate .
                $this heritage:hasPerformer ?performer .
                ?performer heritage:performerAccessLevel ?perfLevel .
                $this heritage:relatedInstrument ?instrument .
                ?instrument heritage:restrictionEffectiveDate ?restrDate .
                ?instrument heritage:requiredAccessLevel ?reqLevel .

                FILTER (?recDate > ?restrDate)

                FILTER (str(?perfLevel) < str(?reqLevel))
            }
        """
    ] .

ex:PerformerCheckShape
    a sh:NodeShape ;
    sh:targetClass heritage:Recording ;
    sh:property [
        sh:path heritage:hasPerformer ;
        sh:minCount 1 ;
        sh:message "Recording missing performer information." ;
        sh:severity sh:Warning ;
    ] .

ex:DateFormatShape
    a sh:NodeShape ;
    sh:targetSubjectsOf heritage:recordingDate, heritage:restrictionEffectiveDate ;
    
    sh:property [
        sh:path heritage:recordingDate ;
        sh:datatype xsd:date ;
        sh:message "Invalid recordingDate format (must be xsd:date)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path heritage:restrictionEffectiveDate ;
        sh:datatype xsd:date ;
        sh:message "Invalid restrictionEffectiveDate format (must be xsd:date)." ;
        sh:severity sh:Violation ;
    ] .